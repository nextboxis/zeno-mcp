# ==============================================================================
# Zeno MCP Environment Configuration Template
# Copy this file to `.env` and fill in your values if using cloud LLM features.
# Note: Zeno MCP runs 100% offline on-device by default with zero cloud tokens.
# ==============================================================================

# (Optional) Google Gemini API Key for hybrid cloud inference fallback
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Custom workspace directories
# ZENO_SKILLS_PATH=./skills
# ZENO_VAULT_PATH=./vault
# ZENO_WORKSPACE_PATH=./workspace
